{
  "name": "Insparc - Shopify & WooCommerce WhatsApp Abandoned Cart Recovery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cart-abandoned",
        "options": {}
      },
      "id": "node-shopify-cart-webhook",
      "name": "Shopify Cart Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "cart-recovery-hook"
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "minutes"
      },
      "id": "node-wait-timer",
      "name": "Wait 30 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "=https://{{ $env.SHOPIFY_STORE_DOMAIN }}/admin/api/2024-04/orders.json?checkout_token={{ $('Shopify Cart Webhook').item.json.body.token }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "node-check-shopify-order",
      "name": "Check If Order Completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "insparc_shopify_admin_token",
          "name": "Shopify Admin Access Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-unpaid",
              "leftValue": "={{ $json.orders ? $json.orders.length : 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-filter-unpaid",
      "name": "Filter Only Unpaid Carts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $('Shopify Cart Webhook').item.json.body.phone }}"
            },
            {
              "name": "type",
              "value": "template"
            },
            {
              "name": "template",
              "value": "{\"name\":\"abandoned_cart_recovery_10\",\"language\":{\"code\":\"en_US\"},\"components\":[{\"type\":\"body\",\"parameters\":[{\"type\":\"text\",\"text\":\"{{ $('Shopify Cart Webhook').item.json.body.customer.first_name || 'there' }}\"},{\"type\":\"text\",\"text\":\"10% OFF\"}]},{\"type\":\"button\",\"sub_type\":\"url\",\"index\":\"0\",\"parameters\":[{\"type\":\"text\",\"text\":\"{{ $('Shopify Cart Webhook').item.json.body.abandoned_checkout_url }}\"}]}]}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-send-recovery-wa",
      "name": "Dispatch WhatsApp Recovery Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "insparc_wa_token",
          "name": "Meta WhatsApp Access Token"
        }
      }
    }
  ],
  "connections": {
    "Shopify Cart Webhook": {
      "main": [
        [
          {
            "node": "Wait 30 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 Minutes": {
      "main": [
        [
          {
            "node": "Check If Order Completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Order Completed": {
      "main": [
        [
          {
            "node": "Filter Only Unpaid Carts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Only Unpaid Carts": {
      "main": [
        [
          {
            "node": "Dispatch WhatsApp Recovery Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

