{
  "name": "Insparc - WhatsApp AI Lead Qualifier & Appointment Booking Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "options": {}
      },
      "id": "node-trigger-wa",
      "name": "WhatsApp Webhook Listener",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "insparc-wa-webhook"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "business_name",
              "value": "Insparc Technology"
            },
            {
              "name": "calendar_id",
              "value": "primary"
            },
            {
              "name": "sheet_id",
              "value": "1ABCxyzReplaceWithYourGoogleSheetID"
            }
          ]
        },
        "options": {}
      },
      "id": "node-config-vars",
      "name": "Set Business Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst entry = body.entry?.[0] || {};\nconst change = entry.changes?.[0]?.value || {};\nconst message = change.messages?.[0] || {};\nconst contact = change.contacts?.[0] || {};\n\nconst phone = message.from || 'unknown';\nconst name = contact.profile?.name || 'Prospect';\nconst text = message.text?.body || '';\nconst messageId = message.id || '';\n\nif (!text) {\n  return [];\n}\n\nreturn [{\n  json: {\n    phone,\n    name,\n    text,\n    messageId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-extract-msg",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "node-openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [900, 520],
      "credentials": {
        "openAiApi": {
          "id": "insparc_openai_cred",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an elite, polite sales & booking assistant for {{ $('Set Business Variables').item.json.business_name }}.\nIncoming message from {{ $json.name }} ({{ $json.phone }}): \"{{ $json.text }}\"\n\nClassify the intent and extract requirements:\nRespond with a valid JSON strictly formatted as:\n{\n  \"intent\": \"book_call\" | \"ask_faq\" | \"pricing\" | \"escalate_human\",\n  \"service_interest\": string,\n  \"budget_range\": string,\n  \"client_reply\": string,\n  \"ready_for_calendar\": boolean\n}",
        "options": {
          "systemMessage": "You represent Insparc Technology. Be concise, respectful, and guide the prospect toward booking a consultation or resolving their query. Never invent facts."
        }
      },
      "id": "node-ai-agent",
      "name": "AI Intent & Lead Qualifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-ready-calendar",
              "leftValue": "={{ $json.ready_for_calendar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-switch-intent",
      "name": "Check Ready for Calendar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "calendar": "={{ $('Set Business Variables').item.json.calendar_id }}",
        "start": "={{ $now.plus({ days: 1 }).set({ hour: 11, minute: 0 }).toISO() }}",
        "end": "={{ $now.plus({ days: 1 }).set({ hour: 11, minute: 30 }).toISO() }}",
        "summary": "=Automation Discovery: {{ $('Extract Message Data').item.json.name }}",
        "description": "=Phone: {{ $('Extract Message Data').item.json.phone }}\nService: {{ $json.service_interest }}\nBudget: {{ $json.budget_range }}",
        "additionalFields": {}
      },
      "id": "node-google-calendar",
      "name": "Reserve Calendar Slot",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [1380, 200],
      "credentials": {
        "googleCalendarOAuth2": {
          "id": "insparc_gcal_cred",
          "name": "Google Calendar OAuth"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Set Business Variables').item.json.sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "dataMode": "autoMapInputData",
        "options": {}
      },
      "id": "node-google-sheets",
      "name": "Save Lead to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [1600, 200],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "insparc_gsheets_cred",
          "name": "Google Sheets OAuth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $('Extract Message Data').item.json.phone }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={{ $json.client_reply || 'Thank you for reaching out! A specialist will contact you shortly.' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-send-wa-reply",
      "name": "Send WhatsApp Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1820, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "insparc_wa_token",
          "name": "Meta WhatsApp Access Token"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Webhook Listener": {
      "main": [
        [
          {
            "node": "Set Business Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Business Variables": {
      "main": [
        [
          {
            "node": "Extract Message Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Message Data": {
      "main": [
        [
          {
            "node": "AI Intent & Lead Qualifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Intent & Lead Qualifier",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Intent & Lead Qualifier": {
      "main": [
        [
          {
            "node": "Check Ready for Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Ready for Calendar": {
      "main": [
        [
          {
            "node": "Reserve Calendar Slot",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve Calendar Slot": {
      "main": [
        [
          {
            "node": "Save Lead to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Lead to Sheets": {
      "main": [
        [
          {
            "node": "Send WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

