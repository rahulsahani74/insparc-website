# ─────────────────────────────────────────────────────────────
# Insparc Technology — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# Only NEXT_PUBLIC_* variables reach the browser.
# ─────────────────────────────────────────────────────────────

# ── General Site Configuration ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payment Gateway & Marketplace (Razorpay) ──
# If omitted or left blank, the store runs in Staging Test Mode for testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cryptographic Signature Secret for Private Downloads ──
# Used to generate HMAC-SHA256 download tokens with 24-hour expiration
PAYMENT_SECRET=generate_a_random_32_byte_hex_string_here

# ── WhatsApp Cloud API (Meta for Developers) ──
WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=

# ── AI Reasoning & LLM Services ──
OPENAI_API_KEY=

# ── Email Delivery (Resend) ──
RESEND_API_KEY=

# ── Anti-Spam (Cloudflare Turnstile) ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── n8n Webhook Hook ──
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
